    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/bcrypt": "^5.0.2",
    "dotenv": "^16.4.5"
  }
