# --- Veritabani ---
# Uygulama zamaninda kisitli rolle baglanir (RLS bu role uygulanir)
DATABASE_URL="postgresql://app_runtime:app_runtime_pw@localhost:5432/yoklama"
# Migration/seed icin sema sahibi rol (RLS'i bypass eder)
MIGRATE_DATABASE_URL="postgresql://yoklama_owner:owner_pw@localhost:5432/yoklama"

# --- Auth ---
JWT_ACCESS_SECRET="degistir-bu-cok-gizli-bir-deger-olmali"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="degistir-bunu-da-farkli-bir-gizli-deger-yap"
JWT_REFRESH_TTL="30d"

# --- QR yoklama ---
QR_TOKEN_SECRET="degistir-ogrenci-kart-qr-kodlari-icin-ayri-bir-gizli-deger"

# --- Veli bildirimleri ---
ABSENCE_ALERT_THRESHOLD=3
# SMTP_HOST bos birakilirsa e-posta gonderilmez, sadece loglanir (yerel gelistirme icin yeterli)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="yoklama@example.org"

# --- API ---
API_PORT=3001
CORS_ORIGIN="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

NODE_ENV="development"
